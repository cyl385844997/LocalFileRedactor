# 依赖与构建产物
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# 测试样例（合成数据，不入库）
samples/
# 脱敏输出目录（本地跑出来的结果，不入库）
redacted_output/
redacted_output*/
out/

# 探测目录（开发期临时产物，一律不入库）
*_probe/
probe/
temp/
我的测试输出/

# 验证产物目录（.verify/：测试输出、报告样本、临时 docx，一律不入库）
.verify/

# pytest 缓存与临时目录（basetemp 已在 pyproject.toml 固定为 pytest_tmp/）
# pytest 缓存与临时目录
# pytest_tmp/ 是 scripts/test.bat 传入 --basetemp 的目标目录
# pytest_tmp_marvis/ 是独立 agent（Marvis）跑测试的隔离目录
.pytest_cache/
.pytest_tmp/
pytest_tmp/
pytest_tmp_marvis/
# 历史用法：曾用 .pt_* 作为 --basetemp 目录名
.pt_*/
.coverage
htmlcov/

# 隔离 pip 安装目录（探针用：pip install --target=.verify_libs <pkg>）
.verify_libs/

# 编辑器
.idea/
.vscode/
*.swp

# 系统
Thumbs.db
desktop.ini
.DS_Store
# 打包运行时依赖（scripts/install_deps.py 安装的第三方库）
# ★不入库：开源仓库不该包含第三方库副本（体积 + 许可）
deps/

# 打包资产中的临时文件（scripts/gen_app_assets.py 中间产物）
assets/_tmp_*.png

# PyInstaller 构建中间目录
LocalFileRedactor.spec.bak
